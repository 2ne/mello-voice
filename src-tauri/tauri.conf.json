{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mello Voice",
  "version": "0.5.0",
  "identifier": "com.mellovoice.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mello Voice",
        "width": 420,
        "minWidth": 420,
        "height": 550,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "theme": null
      },
      {
        "label": "overlay",
        "title": "Voice Overlay",
        "width": 340,
        "height": 80,
        "resizable": false,
        "fullscreen": false,
        "visible": true,
        "alwaysOnTop": true,
        "focusable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/whisper-cli", "binaries/whisper-server"],
    "resources": {
      "resources/models/ggml-base.en-q8_0.bin": "models/ggml-base.en-q8_0.bin",
      "resources/whisper_public": "whisper_public",
      "resources/whisper_runtime/**/*": "whisper_runtime/",
      "icons/runtime/": "icons/runtime/"
    }
  }
}
