{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mello Voice",
  "version": "1.0.4",
  "identifier": "com.mellovoice.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Mello Voice",
        "width": 420,
        "minWidth": 420,
        "height": 550,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "theme": null
      },
      {
        "label": "overlay",
        "title": "Voice Overlay",
        "width": 340,
        "height": 80,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "alwaysOnTop": true,
        "focusable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/whisper-cli"
    ],
    "resources": {
      "resources/models/ggml-base.en-q8_0.bin": "models/ggml-base.en-q8_0.bin",
      "resources/whisper_runtime/**/*": "whisper_runtime/",
      "icons/runtime/dark/mello-voice-32.png": "icons/runtime/dark/mello-voice-32.png"
    }
  }
}
